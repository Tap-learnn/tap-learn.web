NEXT_PUBLIC_APP_DOWNLOAD_URL=

# Optional: Public contact / support email
NEXT_PUBLIC_SUPPORT_EMAIL=support@tapandlearn.app

# Optional: Waitlist submission endpoint (if external serverless form provider is configured)
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Optional: Google AdSense Publisher & Slot IDs (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
